FROM python:3.12-slim
WORKDIR /app

ENV PYTHONUNBUFFERED=1

# The UI only talks to the API over HTTP, so it does not need the API's
# dependency tree (torch, docling, fastembed...).
RUN pip install --no-cache-dir "streamlit>=1.61.1" requests

COPY ragnar/ui ./ragnar/ui
EXPOSE 8501
CMD ["streamlit", "run", "ragnar/ui/streamlit_app.py"]
