FROM python:3.12-slim
WORKDIR /app

ENV PYTHONUNBUFFERED=1 \
    UV_LINK_MODE=copy \
    PATH="/app/.venv/bin:$PATH"

# System libraries for OpenCV (cv2). python:3.12-slim ships none of them, and
# Docling's table model imports cv2 -> "libxcb.so.1: cannot open shared object".
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        libgl1 libglib2.0-0 libxcb1 libsm6 libxext6 libxrender1 \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir uv

# Dependencies first so this layer is cached until pyproject/uv.lock change.
# The BuildKit cache mount keeps downloaded wheels between builds.
COPY pyproject.toml uv.lock* ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --no-dev --locked --no-install-project

COPY ragnar ./ragnar

# Run from the venv directly: `uv run` re-checks/re-syncs on every start.
CMD ["python", "-m", "ragnar.api.main"]
